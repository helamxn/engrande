---
import Header from '../components/Header.astro';
import Panel from '../components/Panel.astro';
import Workspace from '../components/Workspace.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div
    class="mx-auto flex min-h-full max-w-[1440px] flex-col gap-3 pt-3 pb-5 pr-[max(16px,env(safe-area-inset-right))] pl-[max(16px,env(safe-area-inset-left))] desk:h-full"
  >
    <Header />
    <main class="flex min-h-0 flex-1 flex-col gap-3 desk:grid desk:grid-cols-[minmax(0,1fr)_360px] desk:gap-4">
      <Workspace />
      <Panel />
    </main>
  </div>

  <div class="menu" id="menu" role="menu" hidden></div>
  <div
    class="fixed bottom-[calc(18px+env(safe-area-inset-bottom))] left-1/2 z-40 w-max max-w-[calc(100%-32px)] -translate-x-1/2 rounded-full bg-fg px-4 py-[9px] text-center text-[.88rem] text-page shadow-[0_6px_20px_rgba(0,0,0,.2)]"
    id="toast"
    role="status"
    aria-live="polite"
    hidden
  >
  </div>
</Layout>

<script>
  import { startEditor } from '../editor/main';
  startEditor();
</script>
