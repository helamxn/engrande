---
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import Panel from '../components/Panel.astro';
import Workspace from '../components/Workspace.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div
    class="mx-auto flex min-h-full max-w-[1440px] flex-col gap-3 pt-3 pb-5 pr-[max(16px,env(safe-area-inset-right))] pl-[max(16px,env(safe-area-inset-left))] desk:h-full"
  >
    <Header />
    <main class="flex min-h-0 flex-1 flex-col gap-3">
      <Workspace />
      <Panel />
    </main>
  </div>

  <div class="menu" id="menu" role="menu" hidden></div>

  <!-- ayuda de atajos (tecla «?»): <dialog> nativo, con foco atrapado y Esc para cerrar. Altura fija: al buscar no salta -->
  <dialog
    id="shortcuts"
    aria-labelledby="shortcutsTitle"
    class="m-auto w-[min(760px,calc(100vw-24px))] overflow-hidden rounded-2xl border border-line bg-panel p-0 text-fg shadow-menu backdrop:bg-black/50"
  >
    <div class="flex h-[min(720px,calc(100dvh-24px))] flex-col">
      <div class="flex items-center justify-between gap-3 border-b border-line px-5 py-3">
        <h2 id="shortcutsTitle" class="m-0 text-base font-bold">Atajos de teclado y gestos</h2>
        <button type="button" id="shortcutsClose" class="btn !min-h-9 !px-2" aria-label="Cerrar" title="Cerrar (Esc)">
          <Icon name="x" />
        </button>
      </div>
      <div class="min-h-0 flex-1 overflow-y-auto px-5 pt-4 pb-1">
        <div id="shortcutsBody" class="sk-body"></div>
      </div>
    </div>
  </dialog>
  <div
    class="fixed bottom-[calc(18px+var(--sheet-h,0px)+env(safe-area-inset-bottom))] left-1/2 desk:bottom-[calc(18px+env(safe-area-inset-bottom))] z-40 w-max max-w-[calc(100%-32px)] -translate-x-1/2 rounded-full bg-fg px-4 py-[9px] text-center text-[.88rem] text-page shadow-[0_6px_20px_rgba(0,0,0,.2)]"
    id="toast"
    role="status"
    aria-live="polite"
    hidden
  >
  </div>
</Layout>

<script>
  import { startEditor } from '../editor/main';
  startEditor();
</script>
