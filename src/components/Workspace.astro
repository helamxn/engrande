---
import Icon from './Icon.astro';
/**
 * Mesa de trabajo: historial, zoom y lienzo con las hojas.
 * El lienzo ocupa toda la ventana (es el fondo de la app) y lo demás flota encima como «islas»: las herramientas
 * abajo a la izquierda en escritorio y bajo la cabecera en móvil. El tamaño del póster se dibuja junto a él y la
 * calidad, en la etiqueta de la imagen seleccionada (ver render.ts).
 */
const icon = 'size-[17px]';
---

<section
  class="pointer-events-none fixed top-[68px] left-2 z-10 flex items-end gap-2 desk:top-auto desk:bottom-3 desk:left-3 desk:max-w-[calc(100vw-var(--pr)-24px)]"
>
  <div id="tools" class="island pointer-events-auto relative z-[1] flex items-center p-1">
    <!-- zoom: − porcentaje + (el porcentaje encaja el póster entero al pulsarlo) -->
    <div class="tgroup" role="group" aria-label="Zoom">
      <button type="button" id="zoomOut" title="Alejar (−)" aria-label="Alejar">
        <Icon name="zoomOut" class={icon} />
      </button>
      <button type="button" id="zoomFit" class="tpct" title="Ver todo el póster (Ctrl+0) · 100 % = tamaño real aproximado">
        <span id="zoomPct">100%</span>
      </button>
      <button type="button" id="zoomIn" title="Acercar (+)" aria-label="Acercar">
        <Icon name="zoomIn" class={icon} />
      </button>
    </div>
    <span class="mx-0.5 h-6 w-px bg-line" aria-hidden="true"></span>
    <div class="tgroup" role="group" aria-label="Historial">
      <button type="button" id="undo" title="Deshacer (Ctrl+Z)" aria-label="Deshacer" disabled>
        <Icon name="undo" class={icon} />
      </button>
      <button type="button" id="redo" title="Rehacer (Ctrl+Y)" aria-label="Rehacer" disabled>
        <Icon name="redo" class={icon} />
      </button>
    </div>
  </div>

  <div
    id="stage"
    class="pointer-events-auto fixed inset-0 overflow-hidden bg-desk"
  >
    <canvas
      id="cv"
      role="img"
      aria-label="Vista previa del póster"
      class="absolute inset-0 block size-full touch-none select-none [-webkit-touch-callout:none]"
    ></canvas>
    <!-- zona libre: la parte del lienzo que no tapan las islas (sus márgenes los pone el editor) -->
    <div id="free" class="pointer-events-none absolute inset-0">
      <!--
        pantalla de inicio, solo con el póster vacío: un aviso con el botón para elegir la imagen.
        El contenedor no captura el puntero: se puede seguir usando el lienzo (zoom, menú) alrededor del aviso.
      -->
      <div id="empty" class="absolute inset-0 grid place-items-center overflow-y-auto p-4">
        <div
          class="pointer-events-auto flex max-w-full flex-wrap items-center justify-center gap-x-3 gap-y-2 rounded-xl border border-line bg-panel/95 py-2 pr-2 pl-4 text-[.88rem] text-muted shadow-pop"
        >
          <Icon name="addImage" class="size-5 flex-none text-accent" />
          <span>Suelta aquí una imagen o un PDF, o pégalo</span>
          <button type="button" class="btn btn-primary !min-h-9" data-addfile>Elegir imagen</button>
        </div>
      </div>
      <div
        id="hint"
        class="pointer-events-none absolute bottom-2.5 left-1/2 w-max max-w-[calc(100%-20px)] -translate-x-1/2 rounded-full border border-line bg-panel/90 px-3 py-1 text-center text-[.78rem] text-muted"
      ></div>
    </div>
    <div id="ctxbar" class="ctxbar" role="toolbar" aria-label="Herramientas de la imagen" hidden></div>
    <div
      id="drop"
      class="pointer-events-none absolute inset-0 grid place-items-center border-2 border-dashed border-accent bg-accent/20 font-bold text-accent"
      hidden
    >
      Suelta las imágenes aquí
    </div>
  </div>

</section>
