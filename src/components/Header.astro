---
import Icon from './Icon.astro';
/** Cabecera: marca, agregar imagen y descarga rápida del PDF por hojas. */
---

<header class="flex flex-wrap items-center gap-3">
  <div class="mr-auto flex min-w-0 items-center gap-2.5">
    <svg class="flex-none text-mark" width="30" height="30" viewBox="0 0 30 30" aria-hidden="true">
      <circle cx="15" cy="15" r="8.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
      <circle cx="15" cy="15" r="3.2" fill="currentColor"></circle>
      <path d="M15 1v28M1 15h28" stroke="currentColor" stroke-width="1.6"></path>
    </svg>
    <div>
      <h1 class="m-0 text-[1.45rem] leading-none font-extrabold tracking-[-.01em] [font-stretch:118%]">Pliego</h1>
      <p class="mt-0.5 mb-0 text-[.82rem] text-muted">Pósters grandes impresos por hojas</p>
    </div>
  </div>
  <button class="btn" type="button" id="newPoster" title="Empezar un póster nuevo y borrar el trabajo guardado en este navegador" aria-label="Nuevo póster">
    <Icon name="newPoster" />
    <span class="hidden xs:inline">Nuevo</span>
  </button>
  <button class="btn" type="button" data-addfile>
    <Icon name="addImage" />
    Agregar imagen
  </button>
  <input id="file" class="sr-only" type="file" accept="image/*,application/pdf" multiple tabindex="-1" aria-hidden="true" />
  <button class="btn btn-primary" type="button" id="quickExport">
    <Icon name="download" />
    <span id="qeLabel">Descargar PDF</span>
  </button>
</header>
