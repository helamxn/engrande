---
import Icon from './Icon.astro';
import { BRAND } from '../brand';
/**
 * Cabecera: póster nuevo, agregar imagen y descarga rápida del PDF por hojas. Flota sobre el lienzo, arriba a la
 * izquierda (en pantallas estrechas, solo iconos). La marca no se queda aquí ocupando sitio: se presenta en la
 * bienvenida, con el póster vacío (Workspace.astro); el título queda para lectores de pantalla.
 */
---

<header
  class="island fixed top-2 left-2 z-20 flex max-w-[calc(100vw-16px)] items-center gap-2 p-1.5 desk:top-3 desk:left-3 desk:max-w-[calc(100vw-var(--pr)-24px)]"
>
  <h1 class="sr-only">{BRAND.name}</h1>
  <button class="btn" type="button" id="newPoster" title="Empezar un póster nuevo y borrar el trabajo guardado en este navegador" aria-label="Nuevo póster">
    <Icon name="newPoster" />
    <span class="hidden min-[1100px]:inline">Nuevo</span>
  </button>
  <button class="btn" type="button" data-addfile>
    <Icon name="addImage" />
    <span class="max-sm:sr-only">Agregar imagen</span>
  </button>
  <input id="file" class="sr-only" type="file" accept="image/*,application/pdf" multiple tabindex="-1" aria-hidden="true" />
  <button class="btn btn-primary" type="button" id="quickExport">
    <Icon name="download" />
    <span id="qeLabel" class="max-sm:sr-only">Descargar PDF</span>
  </button>
</header>
