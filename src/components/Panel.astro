---
import Icon from './Icon.astro';
/** Panel lateral con tres pestañas: Hojas, Imágenes y Descargar. En escritorio flota a la derecha y se puede plegar. */
const pane = 'flex min-h-0 flex-1 flex-col gap-[18px] overflow-x-hidden overflow-y-auto overscroll-contain p-4';
const field = 'flex flex-col gap-2';
const tabs = [
  { id: 'sheets', label: 'Hojas' },
  { id: 'image', label: 'Imágenes' },
  { id: 'export', label: 'Descargar' },
];
---

<!--
  Escritorio: tarjeta flotante a la derecha (plegable). Móvil: panel inferior deslizable con tres alturas
  (solo pestañas, media pantalla, completa); la altura la pone layout.ts.
-->
<aside
  id="panel"
  class="island fixed inset-x-0 bottom-0 z-20 flex min-h-0 min-w-0 flex-col overflow-hidden rounded-t-2xl rounded-b-none border-x-0 border-b-0 pb-[env(safe-area-inset-bottom)] desk:top-3 desk:right-3 desk:bottom-3 desk:left-auto desk:w-[360px] desk:rounded-xl desk:border desk:pb-0 desk:panel-off:hidden"
>
  <!-- móvil: asa para arrastrar o tocar (cambia la altura del panel) -->
  <button
    type="button"
    id="sheetHandle"
    class="flex h-7 w-full flex-none cursor-grab touch-none items-center justify-center border-0 bg-transparent desk:hidden"
    aria-controls="panel"
    aria-expanded="false"
    aria-label="Mostrar más o menos opciones"
  >
    <span class="h-1 w-10 rounded-full bg-line"></span>
  </button>
  <div id="sheetTabs" class="flex flex-none items-center border-b border-line px-1">
    <div class="flex min-w-0 flex-1" role="tablist" aria-label="Panel de opciones">
      {tabs.map((t, i) => (
        <button
          type="button"
          class="tab"
          role="tab"
          id={`tab-${t.id}`}
          aria-controls={`pane-${t.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-tab={t.id}
        >
          {t.label}
        </button>
      ))}
    </div>
    <button
      type="button"
      id="panelHide"
      class="hidden size-9 flex-none cursor-pointer place-items-center rounded-lg border-0 bg-transparent text-muted hover:text-fg desk:grid"
      aria-controls="panel"
      aria-label="Ocultar panel"
      title="Ocultar panel (Ctrl+\)"
    >
      <Icon name="panelClose" class="size-[18px]" />
    </button>
  </div>

  <!-- Hojas -->
  <div class={pane} role="tabpanel" id="pane-sheets" aria-labelledby="tab-sheets" data-pane="sheets">
    <div class={field}>
      <div class="lbl">Distribución <span class="val">columnas × filas</span></div>
      <!-- presets en cuadrícula de 4: dos filas parejas en vez de 5 + 3 -->
      <div class="grid grid-cols-4 gap-1.5" id="presets"></div>
      <!-- columnas y filas con la misma estructura que el zoom de la barra: [− valor +] -->
      <div class="grid grid-cols-2 gap-2.5">
        <div class="flex min-w-0 flex-col gap-1">
          <span class="text-[.78rem] text-muted" id="lblCols">Columnas</span>
          <div class="tgroup full" role="group" aria-labelledby="lblCols">
            <button type="button" data-step="cols" data-d="-1" aria-label="Menos columnas" title="Menos columnas"><Icon name="minus" class="size-4" /></button>
            <output id="colsOut" class="tval">2</output>
            <button type="button" data-step="cols" data-d="1" aria-label="Más columnas" title="Más columnas"><Icon name="plus" class="size-4" /></button>
          </div>
        </div>
        <div class="flex min-w-0 flex-col gap-1">
          <span class="text-[.78rem] text-muted" id="lblRows">Filas</span>
          <div class="tgroup full" role="group" aria-labelledby="lblRows">
            <button type="button" data-step="rows" data-d="-1" aria-label="Menos filas" title="Menos filas"><Icon name="minus" class="size-4" /></button>
            <output id="rowsOut" class="tval">1</output>
            <button type="button" data-step="rows" data-d="1" aria-label="Más filas" title="Más filas"><Icon name="plus" class="size-4" /></button>
          </div>
        </div>
      </div>
    </div>
    <div class={field}>
      <div class="lbl" id="lblPaper">Papel</div>
      <div class="seg full" role="group" aria-labelledby="lblPaper">
        <button type="button" data-paper="A4" aria-pressed="true">A4</button>
        <button type="button" data-paper="A3" aria-pressed="false">A3</button>
        <button type="button" data-paper="Carta" aria-pressed="false">Carta</button>
      </div>
    </div>
    <div class={field}>
      <div class="lbl" id="lblOrient">Orientación de cada hoja</div>
      <div class="seg full" role="group" aria-labelledby="lblOrient">
        <button type="button" data-orient="portrait" aria-pressed="true">Vertical</button>
        <button type="button" data-orient="landscape" aria-pressed="false">Horizontal</button>
      </div>
    </div>
    <!-- qué pasa con las imágenes colocadas a mano al cambiar hojas, papel, orientación, margen o solape -->
    <div class={field}>
      <div class="lbl" id="lblRelayout">Al cambiar las hojas</div>
      <div class="seg full" role="group" aria-labelledby="lblRelayout">
        <button type="button" data-relayout="scale" aria-pressed="true">Escalar el diseño</button>
        <button type="button" data-relayout="keep" aria-pressed="false">Mantener tamaño</button>
      </div>
      <p class="note" id="relayoutNote">Las imágenes crecen o se encogen con el póster, sin deformarse.</p>
    </div>
    <div class={field}>
      <label class="lbl" for="margin">Margen sin imprimir <output id="marginOut">6 mm</output></label>
      <input type="range" id="margin" min="0" max="15" step="1" value="6" />
      <p class="note">La mayoría de impresoras caseras no imprimen los últimos 4–6 mm del borde. Para saber cuánto deja la tuya, imprime una hoja de prueba (una sola página).</p>
      <button type="button" class="btn self-start" id="marginTest">
        <Icon name="printer" />
        Hoja de prueba de márgenes
      </button>
    </div>
    <div class={field}>
      <label class="lbl" for="overlap">Solape para pegar <output id="overlapOut">10 mm</output></label>
      <input type="range" id="overlap" class="range-mark" min="0" max="30" step="1" value="10" />
      <p class="note">La franja rosada se imprime en las dos hojas vecinas. Al pegar una encima de otra, no se pierde nada de la imagen.</p>
    </div>
  </div>

  <!-- Imágenes -->
  <div class={pane} role="tabpanel" id="pane-image" aria-labelledby="tab-image" data-pane="image" hidden>
    <p class="sel-note" id="selNote">Selecciona una imagen en el lienzo o en la lista para ver y cambiar su tamaño, posición y opacidad.</p>
    <!-- aviso con la imagen bloqueada: sus medidas no se pueden cambiar hasta desbloquearla -->
    <p class="sel-note !block" id="lockNote" hidden>Imagen bloqueada: no se puede mover ni editar. Desbloquéala con el candado de la lista.</p>
    <!-- varias seleccionadas: lo que se puede cambiar a la vez -->
    <div class="needs-group flex-col gap-3">
      <!-- solo con un grupo entero seleccionado (no con varias sueltas) -->
      <label class="pf" id="gNameField"><span>Nombre del grupo</span><span class="unit"><input id="gName" type="text" maxlength="80" autocomplete="off" spellcheck="false" placeholder="Grupo" class="!font-ui" /></span></label>
      <div class="flex flex-col gap-2">
        <label class="lbl" for="gOpacity">Opacidad de las seleccionadas <output id="gOpacityOut">100 %</output></label>
        <input id="gOpacity" type="range" min="5" max="100" step="1" value="100" />
      </div>
      <div class="flex flex-wrap gap-2 [&>.btn]:flex-auto">
        <button type="button" class="btn" id="gHide"><Icon name="eyeOff" />Ocultar</button>
        <button type="button" class="btn" id="gLock"><Icon name="lock" />Bloquear</button>
      </div>
    </div>
    <div class:list={[field, 'needs-sel']}>
      <label class="pf"><span>Nombre</span><span class="unit"><input id="pName" type="text" maxlength="80" autocomplete="off" spellcheck="false" class="!font-ui" /></span></label>
    </div>
    <div class:list={[field, 'needs-sel', 'edit-sel']}>
      <div class="lbl">Tamaño visible</div>
      <div class="grid grid-cols-[1fr_auto_1fr] items-end gap-2">
        <label class="pf"><span>Ancho</span><span class="unit"><input id="pW" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" /><em>cm</em></span></label>
        <!-- eslabón (no candado: el candado es «bloquear imagen» en la lista), como en Figma -->
        <button type="button" class="lock" id="pLock" aria-pressed="true" title="Mantener proporción" aria-label="Mantener proporción">
          <Icon name="ratioOn" />
        </button>
        <label class="pf"><span>Alto</span><span class="unit"><input id="pH" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" /><em>cm</em></span></label>
      </div>
      <button type="button" class="btn" id="unstretch" hidden>Quitar deformación</button>
    </div>
    <div class:list={[field, 'needs-sel', 'edit-sel']}>
      <div class="lbl">Posición y giro</div>
      <div class="grid grid-cols-2 items-end gap-2">
        <label class="pf"><span>Desde la izquierda</span><span class="unit"><input id="pX" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" /><em>cm</em></span></label>
        <label class="pf"><span>Desde arriba</span><span class="unit"><input id="pY" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" /><em>cm</em></span></label>
        <label class="pf"><span>Rotación</span><span class="unit"><input id="pR" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" /><em>°</em></span></label>
        <label class="pf" id="pdfField" hidden><span>Página del PDF <b id="pdfPages"></b></span><span class="unit"><input id="pdfPage" type="number" min="1" value="1" /></span></label>
      </div>
      <div class="flex flex-wrap gap-2 [&>.btn]:flex-auto">
        <button type="button" class="btn" id="fitContain" title="Ajustar: la imagen entera cabe en el póster"><Icon name="fitContain" />Ajustar</button>
        <button type="button" class="btn" id="fitCover" title="Llenar: cubre todo el póster (lo que sobra queda fuera)"><Icon name="fitCover" />Llenar</button>
        <button type="button" class="btn" id="center" title="Centrar en el póster"><Icon name="center" />Centrar</button>
      </div>
    </div>
    <div class:list={[field, 'needs-sel', 'edit-sel']}>
      <label class="lbl" for="pOpacity">Opacidad <output id="pOpacityOut">100 %</output></label>
      <input id="pOpacity" type="range" min="5" max="100" step="1" value="100" />
    </div>
    <div class="h-px flex-none bg-line"></div>
    <div class={field}>
      <div class="lbl">Imágenes en el póster <span class="val" id="layerCount"></span></div>
      <ol class="m-0 flex list-none flex-col gap-1.5 p-0" id="layers"></ol>
      <button type="button" class="btn" data-addfile>
        <Icon name="addImage" />
        Agregar imagen
      </button>
      <p class="note">Arriba en la lista = al frente en el póster. Arrastra las filas (o usa <span data-keys="alt+↑|alt+↓">Alt + ↑ o ↓</span>) para cambiar el orden.</p>
      <p class="note" id="saveInfo" aria-live="polite">Tu póster se guarda automáticamente en este navegador.</p>
    </div>
    <button type="button" class="btn self-start" data-shortcuts>
      <Icon name="keyboard" />
      Atajos de teclado y gestos
      <kbd>?</kbd>
    </button>
  </div>

  <!-- Descargar -->
  <div class={pane} role="tabpanel" id="pane-export" aria-labelledby="tab-export" data-pane="export" hidden>
    <!-- qué se va a descargar y, solo si hace falta, un aviso de calidad (lo rellena updateStats) -->
    <div id="exportSummary" class="flex flex-col gap-2.5" aria-live="polite"></div>
    <div class={field}>
      <div class="lbl" id="lblDpi">Resolución del PDF</div>
      <div class="seg full" role="group" aria-labelledby="lblDpi">
        <button type="button" data-dpi="150" aria-pressed="true">150 ppp</button>
        <button type="button" data-dpi="200" aria-pressed="false">200 ppp</button>
        <button type="button" data-dpi="300" aria-pressed="false">300 ppp</button>
      </div>
      <p class="note">Puntos por pulgada (ppp). 150 basta para un póster que se mira a un metro; 300 da archivos mucho más pesados.</p>
    </div>
    <label class="check"><input type="checkbox" id="marks" checked /><span>Marcas de corte y de solape<small>Esquinas para recortar y línea discontinua donde va la hoja vecina.</small></span></label>
    <label class="check"><input type="checkbox" id="guide" checked /><span>Página de guía de armado<small>Primera página con el mapa de hojas y los pasos.</small></span></label>
    <div class={field}>
      <button type="button" class="btn btn-primary" id="exportTiles">Descargar PDF por hojas</button>
      <button type="button" class="btn" id="exportSingle">PDF en una sola hoja grande (para imprenta)</button>
      <div class="min-h-[1.2em] font-mono text-[.8rem] text-muted" id="status" aria-live="polite"></div>
    </div>
    <p class="note">Imprime en el mismo papel que elegiste, sin «Ajustar al área de impresión». Comprueba con la regla de la guía: si no mide 10 cm, la impresora reescaló y las hojas no encajarán.</p>
  </div>
</aside>

<!-- con el panel plegado (solo escritorio): botón flotante para volver a mostrarlo -->
<button
  type="button"
  id="panelShow"
  class="island hidden size-11 cursor-pointer place-items-center text-muted hover:text-fg desk:fixed desk:top-3 desk:right-3 desk:z-20 desk:panel-off:grid"
  aria-controls="panel"
  aria-label="Mostrar panel"
  title="Mostrar panel (Ctrl+\)"
>
  <Icon name="panelOpen" class="size-[18px]" />
</button>
