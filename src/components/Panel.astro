---
import Icon from './Icon.astro';
import SelectionCard from './SelectionCard.astro';
/**
 * Póster (las hojas), Capas (la lista) y Selección (SelectionCard).
 * - Escritorio y tableta: cada una aparece cuando hace falta. Póster y Capas son tarjetas propias que se abren con
 *   sus botones de arriba a la derecha; Selección es el panel lateral, que aparece al seleccionar algo y se va al
 *   deseleccionar. panel.ts (placePanes) lleva cada sección a su tarjeta.
 * - Móvil: panel inferior deslizable con las tres pestañas.
 * Las descargas están en la cabecera (Descargar PDF y su flecha).
 */
const pane = 'flex min-h-0 flex-1 flex-col gap-[18px] overflow-x-hidden overflow-y-auto overscroll-contain p-4';
const field = 'flex flex-col gap-2';
const tabs = [
  { id: 'sheets', label: 'Póster', pane: 'pane-sheets' },
  { id: 'image', label: 'Capas', pane: 'pane-image' },
  { id: 'sel', label: 'Selección', pane: 'selectionCard' },
];
---

<!--
  Escritorio: panel a la derecha, solo con la selección. Móvil: panel inferior deslizable con tres alturas
  (solo pestañas, media pantalla, completa); la altura la pone layout.ts.
-->
<aside
  id="panel"
  class="island fixed inset-x-0 bottom-0 z-20 flex min-h-0 min-w-0 flex-col overflow-hidden rounded-t-2xl rounded-b-none border-x-0 border-b-0 pb-[env(safe-area-inset-bottom)] desk:top-[calc(var(--top-row,64px)+8px)] desk:right-3 desk:bottom-auto desk:left-auto desk:max-h-[calc(100dvh-var(--top-row,64px)-84px)] desk:w-(--pw) desk:rounded-xl desk:border desk:pb-0 desk:panel-off:hidden"
>
  <!-- móvil: asa para arrastrar o tocar (cambia la altura del panel) -->
  <button
    type="button"
    id="sheetHandle"
    class="flex h-5 w-full flex-none cursor-grab touch-none items-center justify-center border-0 bg-transparent desk:hidden"
    aria-controls="panel"
    aria-expanded="false"
    aria-label="Mostrar más o menos opciones"
  >
    <span class="h-1 w-10 rounded-full bg-line"></span>
  </button>
  <div id="sheetTabs" class="flex flex-none items-center border-b border-line px-1 desk:hidden">
    <div class="flex min-w-0 flex-1" role="tablist" aria-label="Panel de opciones">
      {tabs.map((t, i) => (
        <button
          type="button"
          class="tab"
          role="tab"
          id={`tab-${t.id}`}
          aria-controls={t.pane}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-tab={t.id}
        >
          {t.label}
        </button>
      ))}
    </div>
    <button
      type="button"
      id="panelHide"
      class="hidden size-9 flex-none cursor-pointer place-items-center rounded-lg border-0 bg-transparent text-muted hover:text-fg desk:grid"
      aria-controls="panel"
      aria-label="Ocultar panel"
      title="Ocultar panel (Ctrl+\)"
    >
      <Icon name="panelClose" class="size-[18px]" />
    </button>
  </div>

  <!-- Póster: las hojas (cuántas, papel, orientación, margen y solape). El PDF tiene su tarjeta (Header.astro) -->
  <div class={pane} role="tabpanel" id="pane-sheets" aria-labelledby="tab-sheets" data-pane="sheets">
    <div class={field}>
      <div class="lbl" id="sizeModeLabel">Tamaño del póster</div>
      <div class="seg full" role="group" aria-labelledby="sizeModeLabel">
        <button type="button" id="bySheets" aria-pressed="true">Por hojas</button>
        <button type="button" id="bySize" aria-pressed="false">Por tamaño</button>
      </div>
      <div id="sizeFields" hidden>
        <div class="grid grid-cols-2 gap-2">
          <!-- como los demás campos de medida (Selección): texto con coma decimal, operaciones y la unidad dentro -->
          {([['posterWidth', 'Ancho'], ['posterHeight', 'Alto']] as const).map(([id, label]) => (
            <label class="pf"><span>{label}</span><span class="unit"><input {id} type="text" inputmode="decimal" autocomplete="off" spellcheck="false" /><em>cm</em></span></label>
          ))}
        </div>
        <p id="tileSummary" class="note mt-2" aria-live="polite"></p>
      </div>
    </div>
    <div class={field} id="sheetFields">
      <div class="lbl">Distribución <span class="val">columnas × filas</span></div>
      <!-- presets en cuadrícula de 4: dos filas parejas en vez de 5 + 3 -->
      <div class="grid grid-cols-4 gap-1.5" id="presets"></div>
      <!-- columnas y filas con la misma estructura que el zoom de la barra: [− valor +] -->
      <div class="grid grid-cols-2 gap-2.5">
        <div class="flex min-w-0 flex-col gap-1">
          <span class="text-[.78rem] text-muted" id="lblCols">Columnas</span>
          <div class="tgroup full" role="group" aria-labelledby="lblCols">
            <button type="button" data-step="cols" data-d="-1" aria-label="Menos columnas" title="Menos columnas"><Icon name="minus" class="size-4" /></button>
            <output id="colsOut" class="tval">1</output>
            <button type="button" data-step="cols" data-d="1" aria-label="Más columnas" title="Más columnas"><Icon name="plus" class="size-4" /></button>
          </div>
        </div>
        <div class="flex min-w-0 flex-col gap-1">
          <span class="text-[.78rem] text-muted" id="lblRows">Filas</span>
          <div class="tgroup full" role="group" aria-labelledby="lblRows">
            <button type="button" data-step="rows" data-d="-1" aria-label="Menos filas" title="Menos filas"><Icon name="minus" class="size-4" /></button>
            <output id="rowsOut" class="tval">1</output>
            <button type="button" data-step="rows" data-d="1" aria-label="Más filas" title="Más filas"><Icon name="plus" class="size-4" /></button>
          </div>
        </div>
      </div>
    </div>
    <div class={field}>
      <div class="lbl" id="lblPaper">Papel</div>
      <div class="seg full" role="group" aria-labelledby="lblPaper">
        <button type="button" data-paper="A4" aria-pressed="true">A4</button>
        <button type="button" data-paper="A3" aria-pressed="false">A3</button>
        <button type="button" data-paper="Carta" aria-pressed="false">Carta</button>
      </div>
    </div>
    <div class={field}>
      <div class="lbl" id="lblOrient">Orientación de cada hoja</div>
      <div class="seg full" role="group" aria-labelledby="lblOrient">
        <button type="button" data-orient="portrait" aria-pressed="true">Vertical</button>
        <button type="button" data-orient="landscape" aria-pressed="false">Horizontal</button>
      </div>
    </div>
    <!-- qué pasa con las imágenes colocadas a mano al cambiar hojas, papel, orientación, margen o solape -->
    <div class={field}>
      <div class="lbl" id="lblRelayout">Al cambiar las hojas</div>
      <div class="seg full" role="group" aria-labelledby="lblRelayout">
        <button type="button" data-relayout="scale" aria-pressed="true">Escalar el diseño</button>
        <button type="button" data-relayout="keep" aria-pressed="false">Mantener tamaño</button>
      </div>
      <p class="note" id="relayoutNote">Las imágenes crecen o se encogen con el póster, sin deformarse.</p>
    </div>
    <div class={field}>
      <label class="lbl" for="margin">Margen sin imprimir <output id="marginOut">6 mm</output></label>
      <input type="range" id="margin" min="0" max="15" step="1" value="6" />
      <p class="note">La mayoría de impresoras caseras no imprimen los últimos 4–6 mm del borde. Para saber cuánto deja la tuya, imprime la «Hoja de prueba de márgenes» (una sola página): está en la flecha de «Descargar PDF».</p>
    </div>
    <div class={field}>
      <label class="lbl" for="overlap">Solape para pegar <output id="overlapOut">10 mm</output></label>
      <input type="range" id="overlap" class="range-mark" min="0" max="30" step="1" value="10" />
      <p class="note">La franja rosada se imprime en las dos hojas vecinas. Al pegar una encima de otra, no se pierde nada de la imagen.</p>
    </div>
    <details class="border-t border-line pt-3">
      <summary class="cursor-pointer font-semibold text-sm">Reglas y guías</summary>
      <div class="mt-3 flex flex-col gap-3">
        <label class="check"><input id="rulers" type="checkbox" checked /><span>Mostrar reglas en mm<small>Arrastra desde una regla para crear una guía. Puedes mover la línea o devolverla a su regla para quitarla.</small></span></label>
        <label class="check"><input id="showGuides" type="checkbox" checked /><span>Mostrar guías</span></label>
        <label class="check"><input id="snapGuides" type="checkbox" checked /><span>Ajustar objetos a las guías</span></label>
        <p class="note">Las guías parten de la esquina superior izquierda del área imprimible. Sirven para alinear capas y quedan fuera del PDF.</p>
      </div>
    </details>
  </div>

  <!-- Imágenes -->
  <div class={pane} role="tabpanel" id="pane-image" aria-labelledby="tab-image" data-pane="image" hidden>
    <div class={field} id="posterLayers">
      <div class="lbl">Capas en el póster <span class="val" id="layerCount"></span></div>
      <ol class="m-0 flex list-none flex-col gap-1.5 p-0" id="layers"></ol>
      <!-- sin botones de agregar: están en «＋ Agregar» de la barra de abajo, siempre en el mismo sitio -->
      <p class="note">Arriba en la lista = al frente en el póster. Arrastra las filas (o usa <span data-keys="alt+↑|alt+↓">Alt + ↑ o ↓</span>) para cambiar el orden.</p>
      <p class="note" id="saveInfo" aria-live="polite">Tu póster se guarda automáticamente en este navegador.</p>
    </div>
  </div>

  <SelectionCard />

</aside>

<!--
  Escritorio: botones fijos arriba a la derecha para abrir las tarjetas de Póster y de Capas (el panel de la
  selección se abre debajo). Cada tarjeta es una ventana emergente nativa: se cierra con Esc, con su ✕ o al hacer clic fuera.
-->
<div id="panelOpeners" class="island hidden gap-1 p-1 desk:fixed desk:top-3 desk:right-3 desk:z-20 desk:flex" role="group" aria-label="Póster y capas">
  <button type="button" class="tb" data-open="sheets" popovertarget="posterCard" aria-expanded="false" title="Hojas: cuántas, papel, margen y solape"><Icon name="layoutGrid" />Póster</button>
  <button type="button" class="tb" data-open="image" popovertarget="layersCard" aria-expanded="false" title="Lista de capas: orden, ver, bloquear (Ctrl+\)"><Icon name="layers" />Capas</button>
</div>
<div id="posterCard" popover role="dialog" aria-labelledby="posterCardTitle" class="side-card">
  <div class="side-card-head">
    <h2 id="posterCardTitle" class="lbl m-0">Póster</h2>
    <button type="button" class="selection-close" popovertarget="posterCard" popovertargetaction="hide" aria-label="Cerrar" title="Cerrar (Esc)"><Icon name="x" /></button>
  </div>
  <div class="contents" data-slot="sheets"></div>
</div>
<div id="layersCard" popover role="dialog" aria-labelledby="layersCardTitle" class="side-card">
  <div class="side-card-head">
    <h2 id="layersCardTitle" class="lbl m-0">Capas</h2>
    <button type="button" class="selection-close" popovertarget="layersCard" popovertargetaction="hide" aria-label="Cerrar" title="Cerrar (Esc)"><Icon name="x" /></button>
  </div>
  <div class="contents" data-slot="image"></div>
</div>
