---
import Icon from './Icon.astro';
const field = 'flex flex-col gap-2';
/**
 * Tarjeta de lo seleccionado: mientras hay algo seleccionado ocupa el panel entero, en lugar de las pestañas, con solo
 * los controles de eso (texto, imagen o varias). Al deseleccionar vuelven las pestañas. Ver selectioncard.ts.
 */
---

<section id="selectionCard" class="selection-panel" role="region" aria-labelledby="selectionTitle" hidden>
  <div id="selectionHead" class="selection-head">
    <h2 id="selectionTitle" class="m-0 min-w-0 flex-1 truncate text-[.92rem] font-bold text-fg">Selección</h2>
    <button type="button" id="selectionClose" class="selection-close" aria-label="Deseleccionar y cerrar controles" title="Deseleccionar (Esc)"><Icon name="x" /></button>
  </div>
  <div class="selection-body">
    <!-- aviso con la imagen bloqueada: sus medidas no se pueden cambiar hasta desbloquearla -->
    <p class="sel-note !block" id="lockNote" hidden>Imagen bloqueada: no se puede mover ni editar. Desbloquéala con el candado de la lista.</p>
    <!-- varias seleccionadas: lo que se puede cambiar a la vez -->
    <div class="needs-group flex-col gap-3">
      <!-- solo con un grupo entero seleccionado (no con varias sueltas) -->
      <label class="pf" id="gNameField"><span>Nombre del grupo</span><span class="unit"><input id="gName" type="text" maxlength="80" autocomplete="off" spellcheck="false" placeholder="Grupo" class="!font-ui" /></span></label>
      <div class="flex flex-col gap-2">
        <label class="lbl" for="gOpacity">Opacidad de las seleccionadas <output id="gOpacityOut">100 %</output></label>
        <input id="gOpacity" type="range" min="5" max="100" step="1" value="100" />
      </div>
      <div class="flex flex-col gap-2">
        <div class="lbl" id="lblGAlign">Alinear entre sí</div>
        <div class="seg full" role="group" aria-labelledby="lblGAlign" id="gAlign">
          <button type="button" data-e="left" title="A la izquierda" aria-label="Alinear a la izquierda"><Icon name="alignLeft" /></button>
          <button type="button" data-e="hcenter" title="Al centro (horizontal)" aria-label="Alinear al centro en horizontal"><Icon name="alignHCenter" /></button>
          <button type="button" data-e="right" title="A la derecha" aria-label="Alinear a la derecha"><Icon name="alignRight" /></button>
          <button type="button" data-e="top" title="Arriba" aria-label="Alinear arriba"><Icon name="alignTop" /></button>
          <button type="button" data-e="vcenter" title="Al centro (vertical)" aria-label="Alinear al centro en vertical"><Icon name="alignVCenter" /></button>
          <button type="button" data-e="bottom" title="Abajo" aria-label="Alinear abajo"><Icon name="alignBottom" /></button>
        </div>
      </div>
      <div class="flex flex-col gap-2">
        <div class="lbl" id="lblGDist">Repartir <span class="val" id="gDistNote"></span></div>
        <div class="seg full" role="group" aria-labelledby="lblGDist" id="gDist">
          <button type="button" data-a="x" title="Misma separación en horizontal"><Icon name="distributeH" />Horizontal</button>
          <button type="button" data-a="y" title="Misma separación en vertical"><Icon name="distributeV" />Vertical</button>
        </div>
      </div>
      <div class="flex flex-wrap gap-2 [&>.btn]:flex-auto">
        <button type="button" class="btn" id="gGroup"><Icon name="group" /><span>Agrupar</span></button>
        <button type="button" class="btn" id="gDup"><Icon name="dup" />Duplicar</button>
      </div>
      <div class="flex flex-wrap gap-2 [&>.btn]:flex-auto">
        <button type="button" class="btn" id="gHide"><Icon name="eyeOff" />Ocultar</button>
        <button type="button" class="btn" id="gLock"><Icon name="lock" />Bloquear</button>
        <button type="button" class="btn text-bad" id="gRemove"><Icon name="del" />Quitar</button>
      </div>
    </div>
    <!-- texto seleccionado: fuente, tamaño de letra, color, alineación y espaciado (ver textpanel.ts) -->
    <div class:list={[field, 'needs-sel', 'needs-text', 'edit-sel', 'gap-3']}>
      <label class="pf"><span>Fuente</span><span class="unit"><select id="tFont" class="tsel"></select></span></label>
      <label class="pf"><span>Estilo</span><span class="unit"><select id="tFontStyle" class="tsel"></select></span></label>
      <!-- avisos breves: cargando la fuente, o por qué no están las del equipo (vacíos no se ven) -->
      <p class="note empty:hidden" id="tFontStatus" role="status"></p>
      <p class="note empty:hidden" id="tLocalStatus" role="status"></p>
      <input id="fontFile" class="sr-only" type="file" accept=".ttf,.otf,.woff,font/ttf,font/otf,font/woff" tabindex="-1" aria-hidden="true" />
      <div class="grid grid-cols-2 items-end gap-2">
        <label class="pf"><span>Tamaño de letra</span><span class="unit"><input id="tSize" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" /><em>pt</em></span></label>
        <label class="pf"><span>Altura de una H</span><span class="unit"><input id="tCap" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" aria-describedby="tSizeNote" /><em>cm</em></span></label>
      </div>
      <p class="note" id="tSizeNote">La altura de una H es lo que mide una mayúscula impresa.</p>
      <div class="pf"><label for="tColorHex" class="text-[.72rem] font-semibold text-muted">Color del texto</label><div class="unit text-color-field">
        <input id="tColor" type="color" value="#111111" aria-label="Elegir color del texto" />
        <input id="tColorHex" type="text" value="#111111" maxlength="7" autocomplete="off" spellcheck="false" aria-label="Código de color hexadecimal" aria-describedby="tColorError" />
        <button id="tColorReset" type="button" title="Restablecer color (#111111)" aria-label="Restablecer color predeterminado"><Icon name="history" /></button>
      </div></div>
      <p id="tColorError" class="note text-danger" hidden role="status">Usa un código como #D81B60 o #FFF.</p>
      <label class="check"><input type="checkbox" id="tFit" /><span>Ajustar marco al contorno<small>Quita el espacio del renglón para centrar o alinear las letras con precisión.</small></span></label>
      <div class="seg full" role="group" aria-label="Alineación" id="tAlign">
        <button type="button" data-align="left" aria-pressed="false" title="Alinear a la izquierda" aria-label="Alinear a la izquierda"><Icon name="textLeft" /></button>
        <button type="button" data-align="center" aria-pressed="true" title="Centrar" aria-label="Centrar"><Icon name="textCenter" /></button>
        <button type="button" data-align="right" aria-pressed="false" title="Alinear a la derecha" aria-label="Alinear a la derecha"><Icon name="textRight" /></button>
      </div>
      <div class="flex flex-col gap-2">
        <div class="lbl" id="lblTWidth">Ancho del texto</div>
        <div class="seg full" role="group" aria-labelledby="lblTWidth" id="tWidth">
          <button type="button" data-w="auto" aria-pressed="true" title="Cada línea mide lo que ocupa">Automático</button>
          <button type="button" data-w="fixed" aria-pressed="false" title="Las líneas se parten para no pasarse del ancho">Fijo</button>
        </div>
        <p class="note">Arrastra un lado del marco para fijar el ancho; doble clic en el lado lo vuelve automático.</p>
      </div>
      <div class="flex flex-col gap-1">
        <label class="lbl" for="tLine">Interlineado <output id="tLineOut">1,15</output></label>
        <input id="tLine" type="range" min="0.7" max="2.5" step="0.05" value="1.15" />
      </div>
      <div class="flex flex-col gap-1">
        <label class="lbl" for="tTrack">Espaciado entre letras <output id="tTrackOut">0</output></label>
        <input id="tTrack" type="range" min="-100" max="500" step="5" value="0" />
      </div>
    </div>

  <details id="selectionGeometry" class="needs-sel selection-geometry" open>
    <summary id="selectionGeometryLabel">Posición, tamaño y opacidad</summary>
    <div class="mt-3 flex flex-col gap-4">
    <div class:list={[field, 'needs-sel']}>
      <label class="pf"><span>Nombre</span><span class="unit"><input id="pName" type="text" maxlength="80" autocomplete="off" spellcheck="false" class="!font-ui" /></span></label>
    </div>
    <div class:list={[field, 'needs-sel', 'edit-sel']}>
      <div class="lbl">Tamaño visible</div>
      <div class="grid grid-cols-[1fr_auto_1fr] items-end gap-2">
        <label class="pf"><span>Ancho</span><span class="unit"><input id="pW" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" /><em>cm</em></span></label>
        <!-- eslabón (no candado: el candado es «bloquear imagen» en la lista), como en Figma -->
        <button type="button" class="lock" id="pLock" aria-pressed="true" title="Mantener proporción" aria-label="Mantener proporción">
          <Icon name="ratioOn" />
        </button>
        <label class="pf"><span>Alto</span><span class="unit"><input id="pH" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" /><em>cm</em></span></label>
      </div>
      <button type="button" class="btn" id="unstretch" hidden>Quitar deformación</button>
    </div>
    <div class:list={[field, 'needs-sel', 'edit-sel']}>
      <div class="lbl">Posición y giro</div>
      <div class="grid grid-cols-2 items-end gap-2">
        <label class="pf"><span>Desde la izquierda</span><span class="unit"><input id="pX" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" /><em>cm</em></span></label>
        <label class="pf"><span>Desde arriba</span><span class="unit"><input id="pY" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" /><em>cm</em></span></label>
        <label class="pf"><span>Rotación</span><span class="unit"><input id="pR" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" /><em>°</em></span></label>
        <label class="pf" id="pdfField" hidden><span>Página del PDF <b id="pdfPages"></b></span><span class="unit"><input id="pdfPage" type="number" min="1" value="1" /></span></label>
      </div>
      <div class="flex flex-wrap gap-2 [&>.btn]:flex-auto">
        <button type="button" class="btn" id="fitContain" title="Ajustar: la imagen entera cabe en el póster"><Icon name="fitContain" />Ajustar</button>
        <button type="button" class="btn" id="fitCover" title="Llenar: cubre todo el póster (lo que sobra queda fuera)"><Icon name="fitCover" />Llenar</button>
        <button type="button" class="btn" id="center" title="Centrar en el póster"><Icon name="center" />Centrar</button>
      </div>
    </div>
    <div class:list={[field, 'needs-sel', 'edit-sel']}>
      <label class="lbl" for="pOpacity">Opacidad <output id="pOpacityOut">100 %</output></label>
      <input id="pOpacity" type="range" min="5" max="100" step="1" value="100" />
    </div>

    </div>
  </details>
  </div>
</section>
